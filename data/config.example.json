      { "id": "files", "name": "文件处理", "icon": "file", "kind": "local", "renderer": "files", "group": "端口服务", "desc": "PDF / 图片 / 文本批量处理", "cmd": "services/files/start-files.bat", "cwd": "services/files", "fused": true },
      { "id": "reading-room", "name": "阅览室", "icon": "book", "kind": "local", "renderer": "reading-room", "group": "端口服务", "desc": "电子书与资料阅读", "cmd": "services/reading-room/start-reading-room.bat", "cwd": "services/reading-room", "fused": true },
      { "id": "writing", "name": "写作工作台", "icon": "pen", "kind": "local", "renderer": "writing", "group": "端口服务", "desc": "结构化写作与大纲", "cmd": "services/writing/start-writing.bat", "cwd": "services/writing", "fused": true },
      { "id": "tools", "name": "工具集合", "icon": "tool", "kind": "local", "renderer": "tools", "group": "端口服务", "desc": "网络/文本/系统实用工具汇总", "cmd": "services/tools/start-tools.bat", "cwd": "services/tools", "fused": true },
      { "id": "scripts", "name": "脚本管理", "icon": "code", "kind": "local", "renderer": "scripts", "group": "脚本", "desc": "本地脚本集中管理", "cmd": "services/scripts/start-scripts.bat", "cwd": "services/scripts", "fused": true },
      { "id": "util-json", "name": "JSON 工具", "icon": "braces", "kind": "local", "renderer": "util-json", "group": "工具·文件", "desc": "JSON 格式化 / 压缩 / 校验" },
      { "id": "util-base64", "name": "Base64 编解码", "icon": "code", "kind": "local", "renderer": "util-base64", "group": "工具·文件", "desc": "文本与 Base64 互转（UTF-8）" },
      { "id": "util-timestamp", "name": "时间戳转换", "icon": "clock", "kind": "local", "renderer": "util-timestamp", "group": "工具·文件", "desc": "Unix 时间戳与日期互转" },
      { "id": "util-diff", "name": "文本对比", "icon": "diff", "kind": "local", "renderer": "util-diff", "group": "工具·文件", "desc": "两文本逐行差异对比" }
    ],
    "scripts": []
  },
